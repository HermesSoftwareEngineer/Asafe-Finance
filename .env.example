# Copie para .env e ajuste os valores

# Banco de dados
# Local (SQLite):
DATABASE_URL=sqlite:///./asafe_finance.db

# Produção (Cloud SQL via socket):
# DATABASE_URL=postgresql+psycopg2://usuario:senha@/nome_do_banco?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Produção (PostgreSQL direto):
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco

# Segurança — troque antes de fazer deploy
SECRET_KEY=asafe-vocal-secret-key-change-in-production

# Seed: credenciais do admin inicial (usadas apenas no primeiro boot)
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123

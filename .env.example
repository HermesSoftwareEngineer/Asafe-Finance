# ─────────────────────────────────────────────────────────────────────────────
# Asafe Finance — Variáveis de Ambiente
# Copie este arquivo para .env e preencha conforme o ambiente.
#
#   cp .env.example .env
#
# Valores ativos abaixo são os defaults para DESENVOLVIMENTO LOCAL.
# Troque conforme necessário para produção.
# ─────────────────────────────────────────────────────────────────────────────


# ── Banco de dados ────────────────────────────────────────────────────────────

# Dev — SQLite local (zero configuração)
DATABASE_URL=sqlite:///./asafe_finance.db

# Prod — Supabase via Transaction Pooler (recomendado para Cloud Run)
# Obtenha em: Supabase → Project Settings → Database → Transaction pooler
# DATABASE_URL=postgresql+psycopg2://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require


# ── Segurança ─────────────────────────────────────────────────────────────────

# Dev — pode deixar este valor
SECRET_KEY=dev-secret-key-nao-usar-em-producao

# Prod — gere uma chave forte antes de fazer deploy:
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=cole-aqui-a-chave-gerada


# ── Admin inicial ─────────────────────────────────────────────────────────────
# Usado apenas no primeiro boot para criar o usuário administrador.
# Em produção, troque a senha pelo painel após o primeiro acesso.

ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123

# ─────────────────────────────────────────────────────────────────────────────
# Asafe Finance — Backend — Variáveis de Ambiente
# Copie este arquivo para .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Banco de dados ────────────────────────────────────────────────────────────
# Alterne entre "sqlite" e "supabase" para escolher o banco em dev.
# Em produção (Cloud Run) a variável DATABASE_URL é injetada via Secret Manager
# e ignora DEV_DB por completo.
DEV_DB=sqlite

# SQLite local (zero configuração, padrão para dev)
SQLITE_URL=sqlite:///./asafe_finance.db

# Supabase — Transaction Pooler (recomendado para Cloud Run / conexões efêmeras)
# Obtenha em: Supabase → Project Settings → Database → Transaction pooler
SUPABASE_URL=postgresql+psycopg2://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require


# ── Segurança ─────────────────────────────────────────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-nao-usar-em-producao


# ── Admin inicial ─────────────────────────────────────────────────────────────
# Usado apenas no primeiro boot para criar o usuário administrador.
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123


# ── CORS ──────────────────────────────────────────────────────────────────────
# URL do frontend React (Vercel ou localhost para dev)
FRONTEND_URL=http://localhost:5173
# Prod: FRONTEND_URL=https://seu-app.vercel.app

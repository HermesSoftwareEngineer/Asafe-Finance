# Copie para .env e ajuste os valores

# ── Banco de dados ────────────────────────────────────────────────────────────

# Desenvolvimento local (SQLite):
DATABASE_URL=sqlite:///./asafe_finance.db

# Produção — Supabase (Transaction Pooler — recomendado para Cloud Run):
# DATABASE_URL=postgresql+psycopg2://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Produção — Supabase (Conexão direta — use só se não usar o pooler):
# DATABASE_URL=postgresql+psycopg2://postgres.[ref]:[senha]@db.[ref].supabase.co:5432/postgres?sslmode=require

# ── Segurança ─────────────────────────────────────────────────────────────────

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=asafe-vocal-secret-key-change-in-production

# ── Seed (admin inicial — só usado no primeiro boot) ──────────────────────────

ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123
